# Copy to deploy.env (never commit it). Used by docker compose on your laptop and on the VM.

# ---- image (on the VM: the image GitHub Actions pushes to GitHub Container Registry) ----
# local build:  IMAGE=awaazguard
IMAGE=ghcr.io/<github-username-lowercase>/awaazguard
IMAGE_TAG=latest

# ---- secrets: choose long random values ----
ADMIN_TOKEN=change-me-admin-token
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- DagsHub MLflow (same values as .env) ----
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-username>/awaazguard.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>
MODEL_NAME=awaazguard-aasist

# ---- app ----
MAX_AUDIO_S=30
MONITOR_INTERVAL_MIN=15
MONITOR_MIN_SAMPLES=50
# Leave empty to use http://<same host>:3001 automatically
PUBLIC_GRAFANA_URL=
